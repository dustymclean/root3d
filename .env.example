# Copy to .env.local for local development. Never commit real values.
# Everything here ends up in the public browser bundle, so never put a secret key here.
# (The Supabase anon key is designed to be public; row-level security protects the data.)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

